# Exemplos de nomes de segredos; NUNCA publique valores reais no GitHub.
# Crie valores aleatórios e longos no painel da Cloudflare ou via wrangler secret put.
CREATOR_INVITE_CODE=SUBSTITUIR_POR_CODIGO_ALEATORIO_FORTE
ADMIN_INVITE_CODE=SUBSTITUIR_POR_OUTRO_CODIGO_ALEATORIO_FORTE
PIX_KEY=SUBSTITUIR_POR_CHAVE_PIX_VALIDA
# Usado apenas pelo servidor Node local; na Cloudflare, a origem vem da requisição.
PUBLIC_ORIGIN=http://127.0.0.1:5174
